# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_telegram_bot_token
TELEGRAM_OWNER_ID=123456789

# Gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Limits
MAX_TEXT_CHARS=2500
MAX_AUDIO_BYTES=3000000
MAX_AUDIO_SECONDS=90

# Cost control
MONTHLY_BUDGET_USD=3
WORKER_HARD_STOP_USD=2.50

# Storage
USAGE_BUCKET=telegram-english-bot-usage-your-project-id
USAGE_PREFIX=usage
USAGE_TIMEZONE=America/Sao_Paulo

# Service
SERVICE_NAME=telegram-english-bot
